# Data and runtime roots. External libraries are not distributed by GitHub.
E2N_DATA_ROOT=.
E2N_RUNTIME_DIR=.runtime
E2N_PDB_LIBRARY_DIR=pdb_library
E2N_MOTIF_LIBRARY_DIR=motif_library

# Optional writable/output overrides.
# E2N_MOTIF_OUTPUT_DIR=.runtime/motifs
# E2N_MOTIF_DB_PATH=.runtime/db/motif_index.db
# E2N_CATALYTIC_METAL_DB_PATH=.runtime/db/catalytic_metal_index.db
# E2N_LIGAND_DB_PATH=.runtime/db/ligand_index.db
# E2N_DESIGN_OUTPUT_DIR=.runtime/outputs/design
# E2N_ACTIVITY_VALIDATION_OUTPUT_DIR=.runtime/outputs/activity_validation
# E2N_CACHE_DIR=.runtime/cache

# Local-only Flask defaults. The application does not auto-load this file.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
# FLASK_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# E2N_AUTH_USERNAME=
# E2N_AUTH_PASSWORD=
# E2N_SECRET_KEY=

# Dependency-light default and optional isolated worker controls.
E2N_MLP_BACKEND=geometry_proxy
# E2N_MLP_MODEL=/absolute/path/to/reviewed/model
E2N_ASSEMBLY_SUBPROCESS=1
E2N_CATALYSIS_SUBPROCESS=1
E2N_ASSEMBLY_TIMEOUT=600
E2N_CATALYSIS_TIMEOUT=600
